#
# Environment variables for LensLink AI
# Copy this file to `.env` and configure your settings
#

# Server Configuration
PORT=3000
NODE_ENV=production

# Google Gemini API key for AI summaries (required for AI search)
GEMINI_API_KEY=your_gemini_flash_api_key_here

# Optional: Override the default SearxNG instance (must return JSON)
SEARXNG_URL=https://xng.quest.ac

# Session Secret (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_random_secret_key_here

# HTTPS (set to true if using SSL/TLS with reverse proxy)
HTTPS=false
